<?xml version="1.0" ?>
<robot name="robot_arm">



<!-- BASE `````````````````````````````````````````````````` -->
  <link name="base">
    <visual>
      <geometry>
          <box size="0.75 0.4 0.1"/>
      </geometry>
      <material name="gray">
        <color rgba=".2 .2 .2 1" />
      </material>
    </visual>

    <inertial>
        <mass value="1" />
        <inertia ixx="0.01" ixy="0.0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>

    <collision>
      <geometry>
          <box size="0.75 0.4 0.1"/>
      </geometry>
    </collision>

  </link>


  <!-- ✅ BASE JOINT (Continuous Rotation) -->
  <joint name="base_joint" type="continuous">
    <parent link="base"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ✅ SHOULDER -->
  <link name="shoulder_link">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.3"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.3"/>
      </geometry>
    </collision>
  </link>

  <!-- ✅ SHOULDER JOINT -->
  <joint name="shoulder_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="5.0" velocity="1.0" lower="-1.57" upper="1.57"/>
  </joint>

  <!-- ✅ UPPER ARM -->
  <link name="upper_arm_link">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.4"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0008"/>
    </inertial>
    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.4"/>
      </geometry>
    </collision>
  </link>

  <!-- ✅ ELBOW JOINT -->
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="5.0" velocity="1.0" lower="-1.57" upper="1.57"/>
  </joint>

  <!-- ✅ FOREARM -->
  <link name="forearm_link">
    <visual>
      <geometry>
        <cylinder radius="0.08" length="0.3"/>
      </geometry>
      <material name="green">
        <color rgba="0 1 0 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <collision>
      <geometry>
        <cylinder radius="0.08" length="0.3"/>
      </geometry>
    </collision>
  </link>

  <!-- ✅ WRIST JOINT -->
  <joint name="wrist_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="5.0" velocity="1.0" lower="-1.57" upper="1.57"/>
  </joint>

  <!-- ✅ WRIST -->
  <link name="wrist_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.1"/>
      </geometry>
      <material name="yellow">
        <color rgba="1 1 0 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- ✅ FINGER 1 -->
  <link name="finger1_link">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.1"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="finger1_joint" type="prismatic">
    <parent link="wrist_link"/>
    <child link="finger1_link"/>
    <origin xyz="0.02 0 0.05" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="2.0" velocity="0.5" lower="0.0" upper="0.05"/>
  </joint>

  <!-- ✅ FINGER 2 -->
  <link name="finger2_link">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.1"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="finger2_joint" type="prismatic">
    <parent link="wrist_link"/>
    <child link="finger2_link"/>
    <origin xyz="-0.02 0 0.05" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit effort="2.0" velocity="0.5" lower="0.0" upper="0.05"/>
  </joint>

    <!-- ✅ Custom Posicion Controller -->
  
  <ros2_control name="GazeboSystem" type="system">
  <hardware>
    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
  </hardware>

  <joint name="shoulder_joint">

    <command_interface name="effort">
      <param name="min">-1.57</param>
      <param name="max">1.57</param>
    </command_interface>

    <state_interface name="position">
      <param name="initial_value">0.0</param>
    </state_interface>

    <!--<state_interface name="velocity"/> -->
    <state_interface name="effort"/>

  </joint>


  <joint name="elbow_joint">

    <command_interface name="effort">
      <param name="min">-1.57</param>
      <param name="max">1.57</param>
    </command_interface>

    <state_interface name="position">
      <param name="initial_value">0.0</param>
    </state_interface>

    <!--<state_interface name="velocity"/> -->
    <state_interface name="effort"/>

  </joint>

  <joint name="wrist_joint">
      <command_interface name="effort">
        <param name="min">-1.57</param>
        <param name="max">1.57</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort"/>
    </joint>
    <joint name="finger1_joint">
      <command_interface name="effort">
        <param name="min">-0.5</param>
        <param name="max">0.5</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort"/>
    </joint>
    <joint name="finger2_joint">
      <command_interface name="effort">
        <param name="min">-0.5</param>
        <param name="max">0.5</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort"/>
    </joint>


  </ros2_control>

    <!-- ✅ Gazebo Plugin -->
<gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <robot_sim_type>gazebo_ros2_control/GazeboSystem</robot_sim_type>
      <parameters>/home/maikelborys/assignment_ws/src/robotics_software_engineer/module_5_assignment/config/arm_controller.yaml</parameters>
    </plugin>
</gazebo>

</robot>