<?xml version="1.0" ?>
<robot name="basic_ackermann_car">

  <!-- ✅ BASE CHASSIS -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="1.0 0.6 0.2"/>  <!-- Simple rectangle for the car body -->
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>

    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>

    <collision>
      <geometry>
        <box size="1.0 0.6 0.2"/>
      </geometry>
    </collision>
  </link>

  <!-- ✅ REAR LEFT WHEEL -->
  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>  
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>

    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>

    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.4 0.25 -0.15" rpy="0 1.57 0"/>  
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ✅ REAR RIGHT WHEEL -->
  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>

    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>

    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.4 -0.25 -0.15" rpy="0 1.57 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ✅ FRONT LEFT STEERING HINGE -->
  <link name="front_left_steering_hinge"/>

  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steering_hinge"/>
    <origin xyz="0.4 0.25 -0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="5.0" velocity="1.0" lower="-0.5" upper="0.5"/>
  </joint>

  <!-- ✅ FRONT RIGHT STEERING HINGE -->
  <link name="front_right_steering_hinge"/>

  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steering_hinge"/>
    <origin xyz="0.4 -0.25 -0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="5.0" velocity="1.0" lower="-0.5" upper="0.5"/>
  </joint>

  <!-- ✅ FRONT LEFT WHEEL (Attached to Steering Hinge) -->
  <link name="front_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>

    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>

    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steering_hinge"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0 0" rpy="0 1.57 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ✅ FRONT RIGHT WHEEL (Attached to Steering Hinge) -->
  <link name="front_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>

    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>

    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steering_hinge"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 0 0" rpy="0 1.57 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
